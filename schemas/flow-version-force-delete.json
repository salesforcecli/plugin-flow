{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowVersionForceDeleteCommandReport",
  "description": "C6 manual one-version force deletion. Private confirmation tokens and typed answers are never part of this report. NORMAL mode remains contract 2 in flow-version-delete.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "mode",
    "targetOrg",
    "apiVersion",
    "dryRun",
    "confirmed",
    "confirmationMethod",
    "outcome",
    "plan",
    "deletion"
  ],
  "properties": {
    "contractVersion": {
      "const": "1"
    },
    "mode": {
      "const": "FORCE"
    },
    "targetOrg": {
      "type": "string"
    },
    "apiVersion": {
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "confirmed": {
      "type": "boolean"
    },
    "confirmationMethod": {
      "enum": ["TYPED_FLOW_AND_VERSION", null]
    },
    "outcome": {
      "enum": ["PREVIEWED", "CANCELLED", "SUCCEEDED", "BLOCKED", "FAILED", "UNKNOWN"]
    },
    "plan": {
      "$ref": "#/definitions/Plan"
    },
    "deletion": {
      "anyOf": [
        {
          "$ref": "#/definitions/Result"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowApiName",
        "versionNumber",
        "eligible",
        "reasonCode",
        "pausedInterviewCount",
        "failedInterviewCount",
        "otherInterviewCount",
        "distinctUserCount",
        "oldestInterviewAgeDays",
        "orchestrationInProgressCount",
        "referencingVersionCount",
        "scheduledResumeWithin7Days",
        "workItemCount"
      ],
      "properties": {
        "flowApiName": {
          "type": ["string", "null"]
        },
        "versionNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "eligible": {
          "type": "boolean"
        },
        "reasonCode": {
          "type": ["string", "null"]
        },
        "pausedInterviewCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "failedInterviewCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "otherInterviewCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "distinctUserCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "oldestInterviewAgeDays": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "orchestrationInProgressCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "referencingVersionCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "scheduledResumeWithin7Days": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "workItemCount": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "flowApiName": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,254}$"
              },
              "versionNumber": {
                "type": "integer",
                "minimum": 1
              },
              "reasonCode": {
                "type": "null"
              },
              "pausedInterviewCount": {
                "type": "integer",
                "minimum": 0
              },
              "failedInterviewCount": {
                "type": "integer",
                "minimum": 0
              },
              "otherInterviewCount": {
                "type": "integer",
                "minimum": 0
              },
              "distinctUserCount": {
                "type": "integer",
                "minimum": 0
              },
              "orchestrationInProgressCount": {
                "type": "integer",
                "minimum": 0
              },
              "referencingVersionCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "orgId",
        "definitionId",
        "versionId",
        "flowName",
        "namespace",
        "versionNumber",
        "availableVersionCount",
        "impact",
        "expiresAt",
        "clientPolicyError"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "orgId": {
          "type": "string",
          "pattern": "^00D[A-Za-z0-9]{15}$"
        },
        "definitionId": {
          "type": "string",
          "pattern": "^300[A-Za-z0-9]{15}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^301[A-Za-z0-9]{15}$"
        },
        "flowName": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "versionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "availableVersionCount": {
          "type": "integer",
          "minimum": 1
        },
        "impact": {
          "$ref": "#/definitions/Impact"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "clientPolicyError": {
          "anyOf": [
            {
              "$ref": "#/definitions/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "mode",
        "orgId",
        "definitionId",
        "versionId",
        "flowName",
        "namespace",
        "versionNumber",
        "state",
        "source",
        "targetDeleted",
        "abandonedInterviewCount",
        "error"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "mode": {
          "const": "FORCE"
        },
        "orgId": {
          "type": "string",
          "pattern": "^00D[A-Za-z0-9]{15}$"
        },
        "definitionId": {
          "type": "string",
          "pattern": "^300[A-Za-z0-9]{15}$"
        },
        "versionId": {
          "type": "string",
          "pattern": "^301[A-Za-z0-9]{15}$"
        },
        "flowName": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": ["string", "null"]
        },
        "versionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["SUCCEEDED", "BLOCKED", "FAILED", "UNKNOWN"]
        },
        "source": {
          "enum": ["BACKEND", "CLIENT_POLICY", "SAFETY"]
        },
        "targetDeleted": {
          "type": ["boolean", "null"]
        },
        "abandonedInterviewCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "targetDeleted": {
                "const": true
              },
              "error": {
                "type": "null"
              },
              "abandonedInterviewCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "targetDeleted": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["BLOCKED", "FAILED"]
              }
            }
          },
          "then": {
            "properties": {
              "targetDeleted": {
                "const": false
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dryRun": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "const": false
          },
          "confirmationMethod": {
            "type": "null"
          },
          "outcome": {
            "const": "PREVIEWED"
          },
          "deletion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confirmed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "confirmationMethod": {
            "type": "null"
          },
          "deletion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confirmed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "confirmationMethod": {
            "const": "TYPED_FLOW_AND_VERSION"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": ["PREVIEWED", "CANCELLED"]
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "const": false
          },
          "deletion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "const": true
          },
          "deletion": {
            "type": "object",
            "properties": {
              "state": {
                "const": "SUCCEEDED"
              }
            }
          }
        }
      }
    }
  ]
}
